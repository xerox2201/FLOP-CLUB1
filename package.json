{
  "name": "poker-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "server": "npm -w apps/server run dev",
    "app": "npm -w apps/mini-app run dev",
    "engine:test": "npm -w packages/poker-engine run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,svelte,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,svelte,json,md}\"",
    "test": "npm -w packages/poker-engine run test && npm -w apps/server run test && npm -w apps/mini-app run test",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,svelte}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^9.1.0",
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.6",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.9",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.13.0",
    "eslint-plugin-svelte": "^2.46.0",
    "globals": "^15.11.0",
    "husky": "^9.1.6",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.7",
    "vitest": "^2.1.9"
  }
}
