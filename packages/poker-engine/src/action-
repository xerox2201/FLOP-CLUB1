import { describe, it, expect } from 'vitest';
import { PokerGame } from '../game.js';

type Variant = 'holdem' | 'omaha4' | 'omaha5';

function newGame(variant: Variant, numPlayers: number, stacks?: number[]) {
  const players = Array.from({ length: numPlayers }, (_, i) => ({
    userId: i + 1,
    displayName: `P${i + 1}`,
    stack: stacks?.[i] ?? 1000,
  }));
  return new PokerGame(
    {
      tableId: 1,
      variant,
      speed: 'regular',
      smallBlind: 10,
      bigBlind: 20,
      rakePct: 0,
    },
    players
  );
}

// Helper: do a safe action (check if possible, otherwise call)
function safeAct(g: PokerGame, seat: number) {
  const maxBet = Math.max(...g.state.seats.map((s) => s.betThisStreet));
  const toCall = maxBet - g.state.seats[seat].betThisStreet;
  return g.act(seat, toCall > 0 ? 'call' : 'check', 0);
}

// ============================================================
// 1. Pre-flop order — all 3 variants
// ============================================================
describe('Pre-flop order (multi-way)', () => {
  for (const variant of ['holdem', 'omaha4', 'omaha5'] as Variant[]) {
    it(`${variant}: UTG acts first (left of BB)`, () => {
      const g = newGame(variant, 6);
      g.startHand([]);
      // dealer=0, SB=1, BB=2, UTG=3
      expect(g.state.dealerSeat).toBe(0);
      expect(g.state.currentSeat).toBe(3);
    });

    it(`${variant}: full order = UTG → ... → BTN → SB → BB`, () => {
      const g = newGame(variant, 6);
      g.startHand([]);
      const order: number[] = [g.state.currentSeat];
      for (let i = 0; i < 5; i++) {
        safeAct(g, g.state.currentSeat);
        if (g.state.phase !== 'preflop') break;
        order.push(g.state.currentSeat);
      }
      expect(order).toEqual([3, 4, 5, 0, 1, 2]);
    });

    it(`${variant}: BB is last pre-flop`, () => {
      const g = newGame(variant, 6);
      g.startHand([]);
      let safety = 0;
      while (g.state.phase === 'preflop' && safety < 20) {
        safety++;
        const maxBet = Math.max(...g.state.seats.map((s) => s.betThisStreet));
        const toCall = maxBet - g.state.seats[g.state.currentSeat].betThisStreet;
        g.act(g.state.currentSeat, toCall > 0 ? 'call' : 'check', 0);
      }
      // The last pre-flop actor should have been BB (seat 2)
      // We can't easily verify "last" here, but we verified order above
      expect(g.state.phase).toBe('flop');
    });
  }
});

// ============================================================
// 2. Post-flop order
// ============================================================
describe('Post-flop order', () => {
  it('flop starts from first active left of BTN (SB if still in)', () => {
    const g = newGame('holdem', 6);
    g.startHand([]);
    // Everyone calls/checks to reach flop
    for (let i = 0; i < 6; i++) safeAct(g, g.state.currentSeat);
    expect(g.state.phase).toBe('flop');
    // SB (seat 1) is still active → acts first
    expect(g.state.currentSeat).toBe(1);
  });

  it('flop skips folded SB — starts from BB', () => {
    const g = newGame('holdem', 6);
    g.startHand([]);
    // Preflop order: 3(UTG), 4, 5, 0(BTN), 1(SB), 2(BB)
    // Make seat 1 (SB) fold
    // First: UTG calls
    g.act(3, 'call', 0);
    g.act(4, 'call', 0);
    g.act(5, 'call', 0);
    g.act(0, 'call', 0);
    // SB folds
    g.act(1, 'fold', 0);
    // BB checks
    g.act(2, 'check', 0);
    expect(g.state.phase).toBe('flop');
    // SB folded → first active left of BTN is BB (seat 2)
    expect(g.state.currentSeat).toBe(2);
  });

  it('flop skips SB and BB if both folded', () => {
    const g = newGame('holdem', 6);
    g.startHand([]);
    g.act(3, 'call', 0);   // UTG
    g.act(4, 'call', 0);   // seat 4
    g.act(5, 'call', 0);   // seat 5
    g.act(0, 'call', 0);   // BTN
    g.act(1, 'fold', 0);   // SB folds
    g.act(2, 'fold', 0);   // BB folds
    expect(g.state.phase).toBe('flop');
    // Both blinds folded → first active left of BTN is UTG (seat 3)
    expect(g.state.currentSeat).toBe(3);
  });

  it('turn starts from first active left of BTN', () => {
    const g = newGame('holdem', 4);
    g.startHand([]);
    // Preflop: dealer=0, SB=1, BB=2, UTG=3
    // Order: 3, 0, 1, 2
    g.act(3, 'call', 0);
    g.act(0, 'call', 0);
    g.act(1, 'call', 0);
    g.act(2, 'check', 0);
    // Flop: SB(1), BB(2), UTG(3), BTN(0)
    g.act(1, 'check', 0);
    g.act(2, 'check', 0);
    g.act(3, 'check', 0);
    g.act(0, 'check', 0);
    expect(g.state.phase).toBe('turn');
    // Still all active → SB first
    expect(g.state.currentSeat).toBe(1);
  });

  it('river starts from first active left of BTN', () => {
    const g = newGame('holdem', 4);
    g.startHand([]);
    // Preflop
    g.act(3, 'call', 0);
    g.act(0, 'call', 0);
    g.act(1, 'call', 0);
    g.act(2, 'check', 0);
    // Flop
    g.act(1, 'check', 0);
    g.act(2, 'check', 0);
    g.act(3, 'check', 0);
    g.act(0, 'check', 0);
    // Turn
    g.act(1, 'check', 0);
    g.act(2, 'check', 0);
    g.act(3, 'check', 0);
    g.act(0, 'check', 0);
    expect(g.state.phase).toBe('river');
    expect(g.state.currentSeat).toBe(1);
  });
});

// ============================================================
// 3. Heads-up
// ============================================================
describe('Heads-up order', () => {
  it('preflop: BTN/SB acts first, BB last', () => {
    const g = newGame('holdem', 2);
    g.startHand([]);
    // dealer=0 → SB=0 (dealer), BB=1
    expect(g.state.dealerSeat).toBe(0);
    expect(g.state.currentSeat).toBe(0);
  });

  it('postflop: BB acts first', () => {
    const g = newGame('holdem', 2);
    g.startHand([]);
    g.act(0, 'call', 0);   // SB calls
    g.act(1, 'check', 0);  // BB checks
    expect(g.state.phase).toBe('flop');
    expect(g.state.currentSeat).toBe(1); // BB first postflop
  });

  it('postflop after heads-up flop check: BB then SB', () => {
    const g = newGame('holdem', 2);
    g.startHand([]);
    g.act(0, 'call', 0);
    g.act(1, 'check', 0);
    // Flop: BB first
    expect(g.state.currentSeat).toBe(1);
    g.act(1, 'check', 0);
    expect(g.state.currentSeat).toBe(0);
    g.act(0, 'check', 0);
    // Turn: BB first again
    expect(g.state.phase).toBe('turn');
    expect(g.state.currentSeat).toBe(1);
  });
});

// ============================================================
// 4. Folded players are skipped
// ============================================================
describe('Folded players are skipped', () => {
  it('folded player is skipped in advanceTurn', () => {
    const g = newGame('holdem', 4);
    g.startHand([]);
    // Preflop order: 3(UTG), 0(BTN), 1(SB), 2(BB)
    expect(g.state.currentSeat).toBe(3);
    g.act(3, 'call', 0);
    expect(g.state.currentSeat).toBe(0);
    g.act(0, 'fold', 0);
    // Next should be SB (1), not BTN again
    expect(g.state.currentSeat).toBe(1);
  });

  it('folded player cannot act', () => {
    const g = newGame('holdem', 4);
    g.startHand([]);
    g.act(3, 'call', 0);
    g.act(0, 'fold', 0);
    // Try to act as folded player (seat 0)
    const result = g.act(0, 'call', 0);
    expect(result.ok).toBe(false);
  });
});

// ============================================================
// 5. All-in players are skipped
// ============================================================
describe('All-in players are skipped', () => {
  it('all-in player is skipped in advanceTurn', () => {
    const g = newGame('holdem', 3, [50, 1000, 1000]);
    g.startHand([]);
    // dealer=0, SB=1, BB=2, first=0 (3-handed)
    expect(g.state.currentSeat).toBe(0);
    // Player 0 is all-in (stack=50)
    g.act(0, 'raise', 50);
    expect(g.state.seats[0].allIn).toBe(true);
    // Next should be SB (seat 1)
    expect(g.state.currentSeat).toBe(1);
  });

  it('all-in player cannot act again', () => {
    const g = newGame('holdem', 3, [50, 1000, 1000]);
    g.startHand([]);
    g.act(0, 'raise', 50);
    const result = g.act(0, 'call', 0);
    expect(result.ok).toBe(false);
  });
});

// ============================================================
// 6. Street ends: allActed + allMatched
// ============================================================
describe('Street end conditions', () => {
  it('street ends when all active players have acted and matched', () => {
    const g = newGame('holdem', 4);
    g.startHand([]);
    expect(g.state.phase).toBe('preflop');
    g.act(3, 'call', 0);
    g.act(0, 'call', 0);
    g.act(1, 'call', 0);
    g.act(2, 'check', 0);
    expect(g.state.phase).toBe('flop');
  });

  it('street continues if a player raises after others acted', () => {
    const g = newGame('holdem', 4);
    g.startHand([]);
    g.act(3, 'call', 0);
    g.act(0, 'call', 0);
    g.act(1, 'call', 0);
    // BB raises instead of checking
    g.act(2, 'raise', 40);
    expect(g.state.phase).toBe('preflop'); // still preflop
    // hasActed should reset for those who called before
    expect(g.state.seats[0].hasActed).toBe(false);
    expect(g.state.seats[1].hasActed).toBe(false);
    expect(g.state.seats[3].hasActed).toBe(false);
  });

  it('everyone checks → street advances', () => {
    const g = newGame('holdem', 4);
    g.startHand([]);
    // Preflop
    g.act(3, 'call', 0);
    g.act(0, 'call', 0);
    g.act(1, 'call', 0);
    g.act(2, 'check', 0);
    // Flop: everyone checks
    g.act(1, 'check', 0);
    g.act(2, 'check', 0);
    g.act(3, 'check', 0);
    g.act(0, 'check', 0);
    expect(g.state.phase).toBe('turn');
  });
});

// ============================================================
// 7. Check only allowed when toCall === 0
// ============================================================
describe('Check only allowed when no bet to call', () => {
  it('cannot check if there is a bet', () => {
    const g = newGame('holdem', 4);
    g.startHand([]);
    // UTG raises
    g.act(3, 'raise', 40);
    // BTN tries to check → should fail
    const result = g.act(0, 'check', 0);
    expect(result.ok).toBe(false);
  });

  it('BB can check after everyone calls', () => {
    const g = newGame('holdem', 4);
    g.startHand([]);
    g.act(3, 'call', 0);
    g.act(0, 'call', 0);
    g.act(1, 'call', 0);
    // BB can check (no bet to call)
    const result = g.act(2, 'check', 0);
    expect(result.ok).toBe(true);
  });
});

// ============================================================
// 8. Full hand flow — 6-max
// ============================================================
describe('Full hand flow (6-max, all call/check to showdown)', () => {
  it('plays a complete hand without errors', () => {
    const g = newGame('holdem', 6);
    g.startHand([]);
    let safety = 0;
    while (g.state.phase !== 'showdown' && safety < 100) {
      safety++;
      const seat = g.state.currentSeat;
      safeAct(g, seat);
    }
    expect(g.state.phase).toBe('showdown');
    expect(safety).toBeLessThan(100);
  });

  it('omaha4 full hand to showdown', () => {
    const g = newGame('omaha4', 6);
    g.startHand([]);
    let safety = 0;
    while (g.state.phase !== 'showdown' && safety < 100) {
      safety++;
      safeAct(g, g.state.currentSeat);
    }
    expect(g.state.phase).toBe('showdown');
  });

  it('omaha5 full hand to showdown', () => {
    const g = newGame('omaha5', 6);
    g.startHand([]);
    let safety = 0;
    while (g.state.phase !== 'showdown' && safety < 100) {
      safety++;
      safeAct(g, g.state.currentSeat);
    }
    expect(g.state.phase).toBe('showdown');
  });
});